---
import Typography from '@atoms/Typography.astro'

const PROJECTS = [
  {
    icon: '/images/veriti-logo.svg',
    iconAlt: 'veriti',
  },
  {
    icon: '/images/latrik-logo.svg',
    iconAlt: 'latrik',
  },
  {
    icon: '/images/todos-a-merida-logo.svg',
    iconAlt: 'todos a merida',
  },
  {
    icon: '/images/ticket-scan-logo.svg',
    iconAlt: 'ticket scan',
  },
  {
    icon: '/images/repensar-logo.svg',
    iconAlt: 'repensar',
  },
]
---

<div class="grid grid-cols-1 md:grid-cols-12 gap-10">
  <!-- Slider main container -->
  <div class="md:col-span-7 flex flex-col gap-10">
    <Typography as="h2" color="black" variant="title" class="text-start"> Projects </Typography>
    <div class="projects">
        {
          PROJECTS.map(({ icon, iconAlt }, index) => (
            <div class="bg-blue flex items-center justify-center w-1/5 hover:w-3/5 transition-all duration-300" style={`opacity: ${1 - index * 0.1}`}>
              <img alt={iconAlt} src={icon} class="w-full px-2" />
            </div>
          ))
        }
    </div>
  </div>
  <div class="hidden bg-green text-center md:col-span-5 md:block">
    <Typography as="p" variant="body" color="black" class="p-4 text-4xl font-bold leading-[2.75rem] items-center justify-center">
      If you would like to learn more about our team and products, please let us know by completing and submitting the
      form below.
    </Typography>
  </div>
</div>

<style>
  .projects {
    width: 100%;
    max-width: 200rem;
    height: 700px;
    display: flex;
    flex-direction: row;
  }

</style>

