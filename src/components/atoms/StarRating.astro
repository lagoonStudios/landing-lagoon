---
// StarRating.astro
// Props: rating (number), max (number, default 5)
const { rating = 5, max = 5, className } = Astro.props;
---
<div class={`${className}`}>
  {Array.from({ length: max }).map((_, i) => (
    <svg
      viewBox="0 0 20 20"
      fill={i < rating ? '#FFD600' : '#E5E7EB'}
      class="w-5 h-5"
      aria-hidden="true"
    >
      <polygon points="10,1 12.59,7.36 19.51,7.64 14,12.14 15.82,19.02 10,15.27 4.18,19.02 6,12.14 0.49,7.64 7.41,7.36" />
    </svg>
  ))}
</div>
