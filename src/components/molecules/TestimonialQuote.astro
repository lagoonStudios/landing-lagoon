---
import Typography from '@atoms/Typography.astro'
import QuoteIcon from '@icons/quote.astro'
import type { Testimony } from '../../types/types.ts'
type TestimonyQuote = Pick<Testimony, 'testimony' | 'date' | 'rate' | 'name'> & { class?: string; index?: number }
interface Props extends TestimonyQuote {}

const { testimony, date, rate, name, class: className, index } = Astro.props
---

{
  index != 0 && (
    <li class:list={[className]}>
      <div class="translate-x-[-25px] translate-y-[-10px]">
        <QuoteIcon class="h-[30px] w-auto" />
      </div>
      <Typography as="label" variant="medium" color="black" class="line-clamp-5 font-semibold">
        {testimony}
      </Typography>
      <Typography as="label" variant="medium" color="gray">
        {name}
      </Typography>
      <br />
      <Typography as="label" variant="medium" color="red" class="flex items-center gap-1">
        {Array(rate)
          .fill(0)
          .map((_, i) => (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 25" fill="currentColor">
              <>
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z" />
              </>
            </svg>
          ))}
        <Typography as="label" variant="medium" color="gray">
          {date}
        </Typography>
      </Typography>
    </li>
  )
}
