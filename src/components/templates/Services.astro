---
import Typography from '@atoms/Typography.astro'
import ServicesList from '@organisms/ServicesList.astro'
---

<article class="m-auto mt-5 flex w-[800px] max-w-[calc(100%-2rem)] flex-col gap-5">
  <div class="m-auto mt-5 flex w-[800px] max-w-[calc(100%-2rem)] flex-col gap-5">
    <div class="flex flex-col gap-10 px-8 py-4">
      <Typography as="h2" color="black" variant="title" class="text-3xl"> Our services</Typography>

      <ServicesList />

      <Typography as="h2" variant="title" color="green" class="hidden text-center md:block mt-4">
        Powering Ideas, Delivering Results.
      </Typography>
    </div>
  </div>
</article>
