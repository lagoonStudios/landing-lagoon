---
import TestimonialCard from '@molecules/TestimonialCard.astro'
import TestimonialHighlight from '@molecules/TestimonialHighlight.astro'
import TestimonialQuote from '@molecules/TestimonialQuote.astro'
import type { Testimony } from 'src/types/types'

const TESTIMONIALS: Testimony[] = [
  {
    logo: 'VERITI LOGO',
    testimonyTitle: 'A great team that I recommend to reach the goals in the estimated time.',
    testimony:
      'Thanks to their team, we successfully launched our product to market. Their innovative approach and attention to detail made all the difference.',
    companyName: 'Veriti  app Team',
    name: 'Martin Chapman',
    rate: 5,
    date: 'June 2023',
  },
  {
    logo: '',
    testimonyTitle: 'A great team that I recommend to reach the goals in the estimated time.',
    testimony: 'Exceptional professionals who truly understand product development. They exceeded our expectations.',
    companyName: '',
    name: 'Todos a Merida Fest',
    rate: 5,
    date: 'January 2023',
  },
  {
    logo: '',
    testimonyTitle: 'From concept to execution, their team delivered beyond expectations. Our users love the final product, and so do we!',
    testimony: 'Their strategic insights and technical expertise helped us scale faster than we imagined.',
    companyName: '',
    name: 'Rethinking Tourism Mérida',
    rate: 4,
    date: 'March 2022',
  },
  {
    logo: 'VERITI LOGO',
    testimonyTitle: 'A great team that I recommend to reach the goals in the estimated time.',
    testimony: 'Their strategic insights and technical expertise helped us scale faster than we imagined.',
    companyName: 'Veriti  app Team',
    name: 'Latrik Medical RIS',
    rate: 5,
    date: 'March 2023',
  },
]
---

<div class="flex flex-col gap-10">
  <TestimonialHighlight
    class="hidden md:block"
    testimony={"Optimize your product's performance with our team of experts. We specialize in developing innovative solutions that take your business to the next level."}
    date={TESTIMONIALS[0].date}
    rate={TESTIMONIALS[0].rate}
    name={TESTIMONIALS[0].name}
    testimonyTitle={TESTIMONIALS[0].testimonyTitle}
  />
  <ul class="flex items-center justify-center gap-10 p-3">
    {
      TESTIMONIALS.map(({ logo, testimonyTitle, testimony, companyName, name, rate, date }, index) => (
        <>
          <TestimonialCard
            logo={logo}
            testimonyTitle={testimonyTitle}
            testimony={testimony}
            companyName={companyName}
            name={name}
            rate={rate}
            date={date}
            class=" md:hidden"
          />
          <TestimonialQuote
            testimony={testimony}
            date={date}
            rate={rate}
            name={name}
            class="hidden md:block"
            index={index}
          />
        </>
      ))
    }
  </ul>
</div>
