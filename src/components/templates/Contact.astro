---
// This is required so the Astro page is also rendered on the server,
// allowing us to read the D1 binding and fetch data at build/request time.
export const prerender = false

import Input from '@atoms/Input.astro'
import TextArea from '@atoms/TextArea.astro'
import Typography from '@atoms/Typography.astro'
import LagoonLogo from '@icons/lagoon-logo.astro'

// Get success status from URL
const isSuccess = Astro.url.searchParams.has('success')
---

<footer class="mt-5 w-full bg-purple p-5">
  <div class="m-auto mt-3 flex w-[800px] max-w-[calc(100%-2rem)] flex-col items-center justify-center gap-10">
    <Typography as="h2" variant="title" color="white">Get In Touch</Typography>

    <div
      data-success-banner
      class={`w-full rounded-full border border-white bg-white/10 px-5 py-3 text-center text-sm text-white ${
        isSuccess ? '' : 'hidden'
      }`}
    >
      Thanks for reaching out! We will get back to you shortly.
    </div>

    <form action="/api/client" method="POST" id="contact-form" class="flex w-full flex-col gap-4">
      <Input name="name" label="Name" color="white" required />
      <Input name="email" label="Email" type="email" color="white" required />

      <TextArea name="message" label="Message" color="white" required />

      <button type="submit" class="mt-2 rounded-full border border-white bg-purple py-1 text-base text-white">
        Send it
      </button>
    </form>

    <LagoonLogo class="text-black" color="white" color="white" />
  </div>
</footer>
<script>
  const form = document.querySelector('#contact-form')
  const successBanner = document.querySelector('[data-success-banner]')

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()

    const formElement = event.currentTarget
    if (!(formElement instanceof HTMLFormElement)) return

    const formData = new FormData(formElement)

    try {
      const response = await fetch(formElement.action, {
        method: formElement.method,
        body: formData,
        headers: {
          Accept: 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
      })

      if (!response.ok) {
        throw new Error(`Request failed with status ${response.status}`)
      }

      const payload: any = await response.json()
      console.log({ payload })
      if (!payload?.success) {
        throw new Error('Unexpected response payload')
      }

      alert('Thanks for your message! We will get back to you shortly.')
      successBanner?.classList.remove('hidden')
      formElement.reset()

      const url = new URL(window.location.href)
      url.searchParams.set('success', 'true')
      window.history.replaceState(null, '', url.toString())
    } catch (error) {
      console.error('Failed to submit contact form', error)
      alert('We could not send your message right now. Please try again later.')
    }
  })
</script>
