---
import Typography from '@atoms/Typography.astro'
import ProjectsCarousel from '@organisms/ProjectsCarousel.astro'
---

<article class="mx-0 mt-5 flex w-full flex-col gap-5">
  <div class="flex flex-col gap-5 py-4">
    <div class="hidden items-center justify-center gap-10 md:flex">
      <div class="width-[400px] ml-20 flex flex-col items-center gap-5">
        <Typography as="h2" color="black" variant="title" class="text-center"> Projects </Typography>
        <ProjectsCarousel />
      </div>

      <div class="flex h-full bg-green p-4 items-center justify-center " style="height: -webkit-fill-available">
        <Typography as="p" variant="body" color="black" class="font-bold md:text-[2rem] lg:text-[2.5rem] p-4 md:leading-[2.5rem] lg:leading-[3rem]">
          If you would like to learn more about our team and products, please let us know by completing and submitting
          the form below.
        </Typography>
      </div>
    </div>

    <Typography as="p" variant="medium" color="black" class="block md:hidden">
      If you would like to learn more about our team and products, please let us know by completing and submitting the
      form below.
    </Typography>
  </div>
</article>
