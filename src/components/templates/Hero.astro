---
import { Image } from 'astro:assets'
import Typography from '../atoms/Typography.astro'
import BackgroundCard from '../molecules/BackgroundCard.astro'
import ExecutiveGroupImg from '@images/executive-group.webp'
---

<article class="flex flex-col items-center gap-7 px-10 md:bg-purple h-auto">
  <div class="m-auto mt-5 flex w-full flex-col gap-5 md:mb-40">
    <Typography as="h1" variant="title" color="purple" class="md-text-white w-full text-start md:text-white">
      Immerse yourself in the world of technology.
    </Typography>
    <div class="relative md:flex md:w-full md:items-start md:justify-center md:gap-10">
      <div class="swiper w-full" style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff;">
        <div class="swiper-wrapper">
          <div class="swiper-slide flex flex-col md:flex-row md:items-start md:gap-10">
            <BackgroundCard>
              <Typography as="p" variant="body" color="white" class="font-extralight md:!text-5xl">
                <Typography as="label" variant="body" color="white" class="font-semibold md:!text-5xl">
                  Our goal is to help companies create and launch successful products.
                </Typography>
                Our team of professionals with a deep knowledge of the industry is ready to help you.
              </Typography>
            </BackgroundCard>
            <Image src={ExecutiveGroupImg} alt="Executive group" class="mt-5 hidden w-auto md:block" />
          </div>

          <!-- Example: Add more slides below as needed -->
          <div class="swiper-slide mx-2 flex flex-col md:flex-row md:items-start md:gap-10">
            <BackgroundCard>
              <Typography as="p" variant="body" color="white" class="font-extralight md:!text-5xl">
                <Typography as="label" variant="body" color="white" class="font-semibold md:!text-5xl">
                  We deliver innovative solutions for your business.
                </Typography>
                Let us help you achieve your technology goals with our expert team.
              </Typography>
            </BackgroundCard>
            <Image src={ExecutiveGroupImg} alt="Executive group" class="mt-5 hidden w-4/5 xl:block" />
          </div>
        </div>
      </div>
    </div>
    <div class="flex items-center justify-center md:hidden">
      <button class="w-full max-w-72 rounded-lg bg-purple">
        <Typography as="label" variant="bodyExtraLight" color="white"> Get started </Typography>
      </button>
    </div>
    <Typography as="p" variant="medium" color="black" class="font-semibold md:hidden">
      Improve your projects with a team of skilled product development professionals.
      <Typography as="label" variant="mediumExtraLight" color="black" class="font-extralight">
        Our success stories reflect our commitment to the projects we undertake.
      </Typography>
    </Typography>
  </div>
</article>
<div class="m-auto mt-5 flex w-[800px] max-w-[calc(100%-2rem)] flex-col gap-5 md:mt-14">
  <Typography as="p" variant="medium" color="black" class="hidden text-2xl font-normal md:block">
    Improve your projects with a team of skilled product development professionals.
    <Typography as="label" variant="mediumExtraLight" color="black" class="font-extralight">
      Our success stories reflect our commitment to the projects we undertake.
    </Typography>
  </Typography>
</div>

<style>
  .swiper {
    width: 100%;
  }

  .swiper-slide {
    color: white;
    width: fit-content;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 8px;
  }
</style>

<script>
  import Swiper from 'swiper'
  import 'swiper/css'

  new Swiper('.swiper', {
    slidesPerView: 1,
    speed: 400,
    spaceBetween: 100,
    autoplay: {
      delay: 100,
    },
  })
</script>
