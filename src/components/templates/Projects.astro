---
import Typography from '@atoms/Typography.astro'
import ProjectsCarousel from '@organisms/ProjectsCarousel.astro'
---

<article class="mx-0 mt-5 flex w-full flex-col gap-5">
  <div class="flex flex-col gap-5 py-4">
    <Typography as="h2" color="black" variant="title" class="text-center"> Projects </Typography>
    <ProjectsCarousel />
    <Typography as="p" variant="medium" color="black" class="block md:hidden">
      If you would like to learn more about our team and products, please let us know by completing and submitting the
      form below.
    </Typography>
  </div>
</article>
