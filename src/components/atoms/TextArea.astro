---
import Typography from './Typography.astro'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'textarea'> & {
  label: string
  name: string
  color?: 'black' | 'white' | 'purple' | 'blue' | 'green' | 'gray' | 'red'
}

const { label, name, color, ...textareaProps } = Astro.props as Props
---

<Typography as="label" variant="medium" color={color || 'black'} class="flex w-full flex-col gap-1 font-normal">
  {label}
  <textarea
    name={name}
    id={name}
    class="w-full rounded-[35px] p-5 text-black"
    rows="6"
    {...textareaProps}
  ></textarea>
</Typography>
