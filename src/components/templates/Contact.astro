---
import Input from '@atoms/Input.astro'
import TextArea from '@atoms/TextArea.astro'
import Typography from '@atoms/Typography.astro'
import LagoonLogo from '@icons/lagoon-logo.astro'
---

<footer class="w-full p-5 bg-purple mt-5">
  <div class="m-auto flex w-[800px] max-w-[calc(100%-2rem)] flex-col items-center justify-center gap-10 mt-3">
    <Typography as="h2" variant="title" color="white">Get In Touch</Typography>

    <form id="contact-form" class="flex w-full flex-col gap-4">
      <Input label="Name" color="white"/>
      <Input label="Email" color="white"/>

      <TextArea label="Message" color='white'/>

      <button type="submit" class="mt-2 rounded-full border border-white bg-purple py-1 text-base text-white">
        Send it
      </button>
    </form>

    <LagoonLogo class="text-black" color="white" color="white"/>
  </div>
</footer>
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')
  form?.addEventListener('submit', (e) => e.preventDefault())
</script>
